{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "alems://schemas/book-import.json",
  "title": "ALEMS — قالب استاندارد فایل کتاب تست",
  "description": "قالب ورود کتاب تست به ALEMS. درخت: درس → فصل → مبحث → زیرمبحث. اعتبارسنجی نهایی در سمت سرور با پیام‌های فارسی انجام می‌شود.",
  "type": "object",
  "required": ["title", "chapters"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "عنوان کتاب — الزامی"
    },
    "publisher": {
      "type": "string",
      "maxLength": 120,
      "description": "ناشر — برای تشخیص کتاب تکراری (عنوان + ناشر) استفاده می‌شود"
    },
    "subject": {
      "type": "string",
      "maxLength": 64,
      "description": "نام درس مرتبط — در صورت تطابق با درخت دروس، به همان درس متصل می‌شود"
    },
    "resource_type": {
      "type": "string",
      "enum": ["book_test", "textbook", "note", "class", "video"],
      "default": "book_test"
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "description": "فهرست فصل‌ها — الزامی",
      "items": { "$ref": "#/definitions/chapter" }
    }
  },
  "definitions": {
    "chapter": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 128 },
        "order_index": { "type": "integer", "minimum": 0 },
        "topics": {
          "type": "array",
          "description": "مباحث فصل — یا این یا questions باید داده داشته باشد",
          "items": { "$ref": "#/definitions/topic" }
        },
        "questions": {
          "type": "array",
          "description": "سوالات مستقیم فصل (بدون مبحث) — به یک مبحث هم‌نام فصل منتقل می‌شود",
          "items": { "$ref": "#/definitions/question" }
        }
      }
    },
    "topic": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 128 },
        "questions": {
          "type": "array",
          "description": "اختیاری — می‌تواند خالی یا غایب باشد (ورود فقط‌فهرست). اگر داده شود، هر سوال number و answer الزامی دارد.",
          "default": [],
          "items": { "$ref": "#/definitions/question" }
        },
        "subtopics": {
          "type": "array",
          "description": "زیرمباحث — فقط یک سطح (زیرمبحثِ زیرمبحث مجاز نیست)؛ می‌توانند بدون سوال باشند",
          "items": {
            "type": "object",
            "required": ["title"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 128 },
              "questions": {
                "type": "array",
                "description": "اختیاری — می‌تواند خالی یا غایب باشد",
                "default": [],
                "items": { "$ref": "#/definitions/question" }
              }
            }
          }
        }
      }
    },
    "question": {
      "type": "object",
      "required": ["number", "answer"],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "شماره سوال در کتاب — در هر مبحث یکتا"
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "پاسخ صحیح (مثلاً \"1\" تا \"5\") — کلید answer یا correct_answer"
        },
        "difficulty": {
          "description": "سطح سختی — آسان/متوسط/سخت یا معادل انگلیسی/عدد ۱-۳",
          "enum": ["easy", "medium", "hard", "آسان", "متوسط", "سخت", "1", "2", "3"]
        },
        "importance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 1,
          "description": "اهمیت از ۱ تا ۵"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "تگ‌های آزاد"
        },
        "text": {
          "type": "string",
          "maxLength": 2000,
          "description": "متن سوال (اختیاری — اگر فقط شماره و ارجاع است)"
        }
      }
    }
  }
}
